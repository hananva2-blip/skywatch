[master]
skywatch-master ansible_host=${master_public_ip} ansible_user=ubuntu private_ip=${master_private_ip}

[workers]
skywatch-worker  ansible_host=${worker1_public_ip} ansible_user=ubuntu private_ip=${worker1_private_ip}
skywatch-worker2 ansible_host=${worker2_public_ip} ansible_user=ubuntu private_ip=${worker2_private_ip}

[k3s_cluster:children]
master
workers

[k3s_cluster:vars]
ansible_ssh_private_key_file=~/.ssh/skywatch-key.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
